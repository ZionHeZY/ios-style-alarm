<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_root"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="@drawable/bg_alarm_capsule"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="46dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alarm_bells" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alarm_body" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/banner_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#884A11"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FF9841"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/banner_snooze"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_snooze_circle"
        android:contentDescription="@string/snooze_row"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_zzz" />

    <ImageButton
        android:id="@+id/banner_stop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_stop_circle"
        android:contentDescription="@string/cancel"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_banner_close" />
</LinearLayout>
